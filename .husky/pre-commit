#!/bin/sh
echo ""
echo "🌿 Flora — verificando tipos TypeScript antes do commit..."
echo ""

pnpm --filter @flora/admin exec tsc --noEmit

if [ $? -ne 0 ]; then
  echo ""
  echo "❌  Erros de TypeScript encontrados no apps/admin."
  echo "    Corrija os erros acima antes de commitar."
  echo ""
  exit 1
fi

echo ""
echo "✅  TypeScript OK — commit liberado."
echo ""
