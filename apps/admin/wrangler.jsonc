{
	// Worker do PAINEL (admin). URL publica: florabotanics.com.br/admin
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flora-admin",
	"main": ".open-next/worker.js",
	"workers_dev": false,
	"compatibility_date": "2026-06-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"routes": [
		{
			// admin* captura /admin, /admin?query=X e /admin/sub-rota em um único padrão
			// sem o asterisco, o Cloudflare trata /admin como casamento exato (sem query string)
			// e requests com ?period=X caem no storefront via wildcard /*
			"pattern": "florabotanics.com.br/admin*",
			"zone_name": "florabotanics.com.br"
		},
		{
			"pattern": "www.florabotanics.com.br/admin*",
			"zone_name": "florabotanics.com.br"
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "flora-admin"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	// middleware.external: true no open-next.config.ts (desde 08/07) resolve o
	// dynamic-require crash — NEXT_PRIVATE_MINIMAL_MODE removido; o middleware
	// de session refresh e proteção de rotas está ativo novamente.
	"vars": {
		"NEXT_PUBLIC_STOREFRONT_URL": "https://florabotanics.com.br",
		"NEXT_PUBLIC_SUPABASE_URL": "https://mbpvzhcrimdwcqkqvoqr.supabase.co",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_zZbCUfG-1KifCBk1VJ_NTw_-RpL9A8g"
	},

	// ─── AMBIENTE DE STAGING ─────────────────────────────────────────
	// Deploy: pnpm deploy:cf:admin:staging
	// URL:    flora-admin-staging.<seu-subdominio>.workers.dev
	// Usa o mesmo Supabase de produção (dados reais, mas Worker isolado)
	"env": {
		"staging": {
			"name": "flora-admin-staging",
			"workers_dev": true,
			"routes": [],
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "flora-admin-staging"
				}
			],
			"vars": {
				"NEXT_PUBLIC_STOREFRONT_URL": "https://florabotanics.com.br",
				"NEXT_PUBLIC_SUPABASE_URL": "https://mbpvzhcrimdwcqkqvoqr.supabase.co",
				"NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_zZbCUfG-1KifCBk1VJ_NTw_-RpL9A8g"
			}
		}
	}
}
