{
	// Worker do PAINEL (admin). URL publica: florabotanics.com.br/admin
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "flora-admin",
	"main": ".open-next/worker.js",
	"workers_dev": false,
	"compatibility_date": "2026-06-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"routes": [
		{
			"pattern": "florabotanics.com.br/admin",
			"zone_name": "florabotanics.com.br"
		},
		{
			"pattern": "florabotanics.com.br/admin/*",
			"zone_name": "florabotanics.com.br"
		},
		{
			"pattern": "www.florabotanics.com.br/admin",
			"zone_name": "florabotanics.com.br"
		},
		{
			"pattern": "www.florabotanics.com.br/admin/*",
			"zone_name": "florabotanics.com.br"
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "flora-admin"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	// ATENÇÃO: rollback temporário (2026-06-14) — site caiu com "Internal
	// Server Error" em todas as rotas após remover esta var e reinstalar.
	// Reintroduzido para restaurar o painel. Ver lib/supabase/middleware.ts
	// — com isso, o refresh automático de sessão fica desativado.
	"vars": {
		"NEXT_PRIVATE_MINIMAL_MODE": "1",
		"NEXT_PUBLIC_STOREFRONT_URL": "https://florabotanics.com.br",
		"NEXT_PUBLIC_SUPABASE_URL": "https://mbpvzhcrimdwcqkqvoqr.supabase.co",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_zZbCUfG-1KifCBk1VJ_NTw_-RpL9A8g"
	}
}
